# 本机开发用的样例配置：复制成 .env 即可用。
# 带值的是本机跑得起来的一套；注释掉的是可选开关与缺省值。标了「生产必须换掉」的别照抄。

# ── 数据库与监听 ────────────────────────────────────────────────
DATABASE_URL=postgres://seeai:seeai@127.0.0.1:5432/seeai_next
API_BIND=127.0.0.1:8081
# 平台对客基址：模型说明与页面里的链接按它写成绝对地址。必填，只写源、结尾不带斜杠。
SEE_BASEURL=http://app.localhost:8081

# ── 管理员 ─────────────────────────────────────────────────────
# 共享管理员令牌：请求头带上它就直接是管理员，不用登录。必填，为空 API 起不来。
# 它不指向具体的人（登录会话才指向），按密钥管：强随机、可轮换。生成：openssl rand -hex 32
ADMIN_TOKEN=8d461765dcd7bdcb5c5004fbd9f31b8b6a3e85a628694e2ed5607b6fea1b3969
# 管理员账号：API 启动时按这两个值建或更新它，运营后台的登录页用它。
# 缺了就只能用上面的令牌调接口，人在浏览器上登录不进去。
ADMIN_EMAIL=ops@example.com
ADMIN_PASSWORD=replace-me-too

# ── 密钥（本文件里两个都是开发占位值，生产必须换掉；同一部署的所有 API 实例必须配同一份）──
# 客户历史翻页游标的加密密钥：必填，32 字节 base64（openssl rand -base64 32）。
# 轮换会让已发出的游标失效，客户重新查询即可，不用清库。
CUSTOMER_HISTORY_CURSOR_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# 请求指纹密钥：必填，32 字节 base64（openssl rand -base64 32）。
# 轮换办法：加一条 V2、把 VERSION 抬到 2，旧版本留着解已受理的请求。
REQUEST_FINGERPRINT_KEY_V1=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
# REQUEST_FINGERPRINT_KEY_VERSION=1

# ── 渠道凭证（调用哪条渠道就填哪一条；为空时那条渠道的请求会失败）──
AIHUBMIX_API_KEY=
APIMART_API_KEY=

# ── 生成与超时 ─────────────────────────────────────────────────
# 兜底保底额（CNY 微单位，20000 = 0.02 元）：只在查不到该供给的保底表时用来算预授权额。
GENERATION_MAX_COST_MICROUSD=20000
# 每账户同时在跑的生成任务数上限。
GENERATION_MAX_CONCURRENT_JOBS=1
# 对客同步等待窗口：必须 ≥ PROVIDER_TIMEOUT_SECONDS，否则启动时拒绝并点名。
GENERATION_SYNC_WAIT_SECONDS=690
# 单次调用上游的超时。
PROVIDER_TIMEOUT_SECONDS=660
# 超时链按输出张数加时：基数已含 4 张，每多一张再加 30 秒。
# 三项与已发布合同声明的张数上限一起校验，不一致时拒绝启动，别单独调大其中一项。
# PROVIDER_TIMEOUT_BASE_SECONDS=180
# PROVIDER_TIMEOUT_INCLUDED_IMAGES=4
# PROVIDER_TIMEOUT_PER_IMAGE_SECONDS=30
# 安全重投：只在能证明上游没有受理时重投（连不上、上传失败、参考图取不到、上游明确拒绝）。
# 状态不确定（超时、5xx、响应读不出）一律不重投，转人工对账。
GENERATION_RETRY_MAX_ATTEMPTS=3
GENERATION_RETRY_BACKOFF_BASE_MS=1000
# 受理侧限流：每把 API Key 每窗口的请求数。
# GENERATION_RATE_LIMIT_REQUESTS_PER_WINDOW=60
# GENERATION_RATE_LIMIT_WINDOW_MS=60000

# ── 加速层（可选；REDIS_URL 留空即不启用，受理与结算全部回源数据库）──
REDIS_URL=redis://127.0.0.1:6379
CACHE_BALANCE_TTL_SECONDS=360
CACHE_RECONCILE_INTERVAL_MS=180000
CACHE_OPERATION_TIMEOUT_MS=200

# ── 本机执行容量（全部有缺省，一般不用写）──────────────────────
# 本机同时在执行的生成任务数：缺省按"内存预算 ÷ 单次预留"推导（缺省预算 2 GiB 下是 4）。
# 写下的值必须真的装得进预算，否则拒绝启动并同时点名这两项。
# GENERATION_EXECUTION_SLOTS=64
# 本机在飞执行可预占的内存总量（字节，缺省 2 GiB）。单次预留按各驱动声明的响应上限算出
# （AIHubMix 当前约 437 MiB），所以缺省预算下并发是 4。
# GENERATION_MAX_MEMORY_BYTES=2147483648
# 读取与发送名额必须落在连接容量内（API_MAX_CONNECTIONS × API_H2_MAX_CONCURRENT_STREAMS），
# 否则拒绝启动：多出来的名额没有连接去持有。
# GENERATION_READ_SLOTS=64
# GENERATION_SEND_SLOTS=64
# GENERATION_SETTLE_RESERVE_SECONDS=10
# GENERATION_EXECUTION_LEASE_SECONDS=60
# GENERATION_MAX_CHANNEL_IN_FLIGHT=32
# GENERATION_SLOW_READ_TIMEOUT_SECONDS=30
# GENERATION_SEND_TIMEOUT_SECONDS=30
# GENERATION_SHUTDOWN_GRACE_SECONDS=25
# 请求体上限：正文超过 16 MiB 回 413；JSON 结构超限在受理前回 400。
# GENERATION_REQUEST_JSON_MAX_DEPTH=64
# GENERATION_REQUEST_JSON_MAX_NODES=2048
# GENERATION_REQUEST_JSON_MAX_OBJECT_FIELDS=256
# GENERATION_REQUEST_JSON_MAX_STRING_BYTES=16777216
# 只读对账查询的响应上限（字节），独立于生成响应上限。
# GENERATION_RECONCILIATION_READ_BYTES=1048576
# 容量观测记录的周期（秒）；0 表示不周期记录，逐次容量拒绝仍然记录。
# GENERATION_OBSERVABILITY_INTERVAL_SECONDS=30
# 连接驱动与断开监视（Linux）：容量、控制队列与 HTTP/1、HTTP/2 缓冲上限。
# API_MAX_CONNECTIONS=1024
# API_MAX_CONNECTION_TASKS=64
# API_MONITOR_CONTROL_QUEUE=1024
# API_MONITOR_CONFIRM_MILLIS=2000
# API_MAX_HEADERS=128
# API_MAX_BUFFER_BYTES=65536
# API_H2_MAX_CONCURRENT_STREAMS=128
# API_H2_MAX_SEND_BUFFER_BYTES=1048576
# API_H2_MAX_HEADER_LIST_BYTES=65536

# ── 供给素材导入（工程侧）──────────────────────────────────────
# API 每次启动会把该目录里的 *.json 素材写成渠道与供给（幂等）。
# 不设时默认 config/bootstrap；设成空串＝不导入（测试库要一份干净的供给清单时用）。
# SUPPLY_MATERIAL_DIR=config/bootstrap

# ── 控制台与运维入口（全部有缺省）──────────────────────────────
# 本地开发的临时出口：设了这个主机名之后，它也回运营后台那一份。生产不要设。
# CONSOLE_DEV_HOST=admin.local
# GET /health 探数据库的超时（毫秒）。
# HEALTH_PROBE_TIMEOUT_MS=2000
# 平台侧故障告警的出口（POST JSON）。没配就没有出口，一条也不外发；地址写错在启动时就失败。
# 请求体只带定位字段（哪次执行失败、哪笔账实不符），不带凭证、提示词与图片。
# PROVIDER_ALERT_WEBHOOK=https://alerts.example.com/seeai
# PROVIDER_ALERT_CONSECUTIVE_FAILURES=3
# PROVIDER_ALERT_TIMEOUT_MS=5000
# PROVIDER_ALERT_RETRIES=2
# 会话与口令重置的有效期（秒）：缺省 12 小时 / 30 分钟。
# SESSION_TTL_SECONDS=43200
# PASSWORD_RESET_TTL_SECONDS=1800
# 公开鉴权端点（注册、登录、重置码兑换）的失败尝试限制：三个端点各自一份，缺省每 60 秒 10 次。
# 达到上限回带 Retry-After 的 429；成功的尝试不累计。
# AUTH_ATTEMPT_LIMIT_REGISTER_FAILURES_PER_WINDOW=10
# AUTH_ATTEMPT_LIMIT_REGISTER_WINDOW_MS=60000
# AUTH_ATTEMPT_LIMIT_LOGIN_FAILURES_PER_WINDOW=10
# AUTH_ATTEMPT_LIMIT_LOGIN_WINDOW_MS=60000
# AUTH_ATTEMPT_LIMIT_REDEEM_FAILURES_PER_WINDOW=10
# AUTH_ATTEMPT_LIMIT_REDEEM_WINDOW_MS=60000
# 采信哪个受信头作为来源（例如 nginx 覆盖写的 x-real-ip）。不设时用连接对端地址；
# 采信它要求 API 不能被绕过代理直连。
# AUTH_SOURCE_HEADER=x-real-ip

# ── Worker 与异常对账（全部有缺省）──────────────────────────────
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
# 账本巡检没有默认周期，只由管理员按账户触发。
# RECONCILIATION_BATCH_LIMIT=16
# RECONCILIATION_ORPHAN_MAX_AGE_SECONDS=900
# RECONCILIATION_LATE_FACT_CLAIM_TTL_SECONDS=300
# RECONCILIATION_QUERY_TIMEOUT_SECONDS=30
# RECONCILIATION_QUERY_MAX_ATTEMPTS=5
# RECONCILIATION_QUERY_BACKOFF_BASE_SECONDS=30
# RECONCILIATION_QUERY_BACKOFF_MAX_SECONDS=3600
# RECONCILIATION_LEDGER_AUDIT_EVERY_ROUNDS=10
# RECONCILIATION_LEDGER_AUDIT_LIMIT=100
# RECONCILIATION_LEDGER_AUDIT_WINDOW_SECONDS=3600

# ── 上传端点与对象存储（阿里云 OSS，可选）──────────────────────
# 调用方把本地文件经 POST /v1/uploads/images 换成公网 URL 再提交生成请求。单文件上限 20 MiB，
# 上传不计费、不计量、不限配额。
# 整组都不给＝未配置：进程照常启动，上传端点回 503；只给一部分或形状不合法＝启动期拒绝并点名。
# 桶必须允许匿名读，否则客户拿不到图。
# UPLOAD_STORAGE_REGION=cn-hangzhou
# UPLOAD_STORAGE_BUCKET=
# 可选，省略时用 https://oss-{region}.aliyuncs.com；显式给出时是含 scheme 的 origin，
# 不带凭证 / path / query。
# UPLOAD_STORAGE_ENDPOINT=
# 访问密钥两条必须成对给。
# UPLOAD_STORAGE_ACCESS_KEY_ID=
# UPLOAD_STORAGE_ACCESS_KEY_SECRET=
# 本机上限与超时（注释里的值是缺省）。
# UPLOAD_MAX_REQUEST_BYTES=22020096
# UPLOAD_SLOTS=4
# UPLOAD_MAX_BUFFER_BYTES=100663296
# 名额 × 单请求字节必须装得进缓冲预算，否则启动期拒绝。
# UPLOAD_REQUEST_TIMEOUT_SECONDS=30
# 正文从开始接收到读完的上限；超时在受理前回 408，不写对象。
# UPLOAD_SLOW_READ_TIMEOUT_SECONDS=30
# 上传限流：每把 API Key 独立计数（与生成分开），超限回 429。
# UPLOAD_RATE_LIMIT_REQUESTS_PER_WINDOW=60
# UPLOAD_RATE_LIMIT_WINDOW_MS=60000
# 写入对象的重试次数与固定退避基准秒数。
# UPLOAD_RETRY_MAX_ATTEMPTS=3
# UPLOAD_RETRY_BACKOFF_BASE_SECONDS=1
