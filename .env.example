DATABASE_URL=postgres://seeai:seeai@127.0.0.1:5432/seeai_next
API_BIND=127.0.0.1:8081
# 共享管理凭据：`Authorization: Bearer <它>` 直接当管理员用，不需要登录。**必填，为空 API 起不来。**
# 它在审计里不指向具体的人（登录会话才指向），所以按密钥管理：强随机、可轮换、别写进脚本或命令行历史。
# 生成用 openssl rand -hex 32（256 位、64 个十六进制字符）之类，别手敲
ADMIN_TOKEN=replace-me
# 管理员账号：API 启动时按这两个值建或更新那个账号，运营后台的登录页用它。
# 缺了它们就只能靠上面的共享令牌调接口，**人在浏览器上登录不进去**。
ADMIN_EMAIL=ops@example.com
ADMIN_PASSWORD=replace-me-too
# 客户历史翻页游标的加密密钥：**必填，为空或不是 32 字节的 base64 时 API 起不来。**
# 生成用 openssl rand -base64 32。同一部署的所有 API 实例必须配同一份；轮换会让已发出的游标失效
# （客户重新查询即可），不需要清库。下面是**开发占位值**（32 字节），生产必须换掉。
CUSTOMER_HISTORY_CURSOR_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
AIHUBMIX_API_KEY=
APIMART_API_KEY=
GENERATION_MAX_COST_MICROUSD=20000
GENERATION_MAX_CONCURRENT_JOBS=1
# 对客同步等待窗口：必须 ≥ PROVIDER_TIMEOUT_SECONDS，否则 API 启动时拒绝并点名。
# 本文件把 PROVIDER_TIMEOUT_SECONDS 设成 660，所以这里取 690（+30）。
GENERATION_SYNC_WAIT_SECONDS=690
# 每账户每日扣费上限（microusd，默认 50000000＝每天 50 美元等值）。它问的是账本上的事实，
# 所以判定每次都从账本聚合，不经过缓存；超限对客是 429 `daily_spend_limit_exceeded`。
GENERATION_MAX_DAILY_SPEND_MICROUSD=50000000
# 加速层（路由候选集与余额缓存）。REDIS_URL 留空即不启用：受理与结算全部回源数据库。
# 本机 redis-server（宿主 6379）：REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
CACHE_ROUTE_TTL_SECONDS=60
CACHE_BALANCE_TTL_SECONDS=360
CACHE_FRESHNESS_WINDOW_MS=5000
CACHE_RECONCILE_INTERVAL_MS=180000
CACHE_OPERATION_TIMEOUT_MS=200
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
PROVIDER_TIMEOUT_SECONDS=660
# 安全重投（只在**可证明上游没有受理**时重投：连不上、上传失败、参考图取不到、上游明确拒绝
# 受理）。状态不确定（超时/5xx/响应读不出）一律不重投，按既有口径进对账。
# 这两项决定最坏情况下一个请求会调几次上游、以及这几次摊在多长的窗口里：
GENERATION_RETRY_MAX_ATTEMPTS=3
GENERATION_RETRY_BACKOFF_BASE_MS=1000
# 单次请求的**上游成本上限**（microusd，人民币微单位，默认 10000000＝10 元）：平台自己的运营护栏，
# 发布期与受理期各判一次（判据与边界见 docs/design/0009 §7）。与 GENERATION_MAX_COST_MICROUSD
# （兜底保底额）不是同一个量。
GENERATION_MAX_REQUEST_COST_MICROUSD=10000000
# 发布素材的导入目录（**工程侧**）：API 进程每次启动都会在迁移之后把该目录里的 *.json 素材
# 写成渠道与 Offering（幂等，匹配键与命中行为见 docs/design/0012-platform-model-publishing.md §3）。
# 素材是工程师写的资产，运营的定价不在其中。**不设时默认 config/bootstrap**（仓库、systemd 与
# Docker 镜像都把素材放在工作目录下）；设成空串＝显式不导入（测试库/开发库要一份干净的供给清单
# 时用）。目录不存在或里面没有素材时跳过。
# SUPPLY_MATERIAL_DIR=config/bootstrap
# 本地开发/验收用的临时出口：设了这个主机名之后，它也回运营后台那一份。
# **生产不要设**——生产的分发判据就是主机名 `admin.<domain>`；本机没有域名可指时才需要它。
# CONSOLE_DEV_HOST=admin.local
# 探活超时（毫秒，缺省 2000）：`GET /health` 探数据库时带的超时。读不出或为 0 退回缺省。
# HEALTH_PROBE_TIMEOUT_MS=2000
# 账本巡检**没有默认周期**：只由管理员按账户触发（`POST /api/v1/accounts/{account_id}/ledger-audit`）。
# 平台侧故障告警的出口（POST JSON）：没配就没有出口，一条也不外发，代码里不写死任何 URL。
# 地址写错在启动时就失败，不让进程带着一个"永远发不出去"的出口跑。
# 请求体只带定位字段（哪次执行失败、哪笔账实不符），不带凭证、提示词与图片。
# PROVIDER_ALERT_WEBHOOK=https://alerts.example.com/seeai
# 某候选连续失败几次才告警（缺省 3，必须 ≥ 1）；告警的超时与重试都**有界**，缺省 5000ms / 2 次。
# PROVIDER_ALERT_CONSECUTIVE_FAILURES=3
# PROVIDER_ALERT_TIMEOUT_MS=5000
# PROVIDER_ALERT_RETRIES=2
# 会话与口令重置的有效期：缺省 12 小时 / 30 分钟。重置令牌能改口令，所以比会话短得多。
# SESSION_TTL_SECONDS=43200
# PASSWORD_RESET_TTL_SECONDS=1800
# 受理侧限流：缺省每分钟 60 次（窗口 60000ms）。它是**运维取值**，不是产品档位——不同部署要挡住的
# 数量级差得很远，所以留成部署期可调。
# GENERATION_RATE_LIMIT_REQUESTS_PER_WINDOW=60
# GENERATION_RATE_LIMIT_WINDOW_MS=60000
# 超时链的分解（按输出张数加时）：基数 180 秒已含 4 张，超出部分每张再加 30 秒。
# **它们与已发布合同声明的输出张数上限一起校验**，不一致时 API 拒绝启动并点名，所以别单独调大其中一项。
# PROVIDER_TIMEOUT_BASE_SECONDS=180
# PROVIDER_TIMEOUT_INCLUDED_IMAGES=4
# PROVIDER_TIMEOUT_PER_IMAGE_SECONDS=30

# ── 直接同步执行（唯一路径）────────────────────────────────────────────
# 两条图片入口都在 API 进程内直连 Provider，没有执行开关：下面的容量与期限无条件生效。
# 取值与校验见 docs/operations/configuration.md §2「直接同步执行」。
# 幂等与请求指纹密钥：**必填**，32 字节 base64（openssl rand -base64 32）。
# 幂等查找摘要不需要密钥；请求指纹密钥按版本轮换（加 V2、抬高 _VERSION、保留旧版本）。
# 同一部署的所有 API 实例必须配同一份。下面是**开发占位值**（32 字节），生产必须换掉。
REQUEST_FINGERPRINT_KEY_V1=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
# REQUEST_FINGERPRINT_KEY_VERSION=1
# GENERATION_SETTLE_RESERVE_SECONDS=10
# GENERATION_EXECUTION_LEASE_SECONDS=60
# GENERATION_MAX_CHANNEL_IN_FLIGHT=32
# GENERATION_EXECUTION_SLOTS=64
# GENERATION_MAX_MEMORY_BYTES=2147483648
# GENERATION_READ_SLOTS=64
# GENERATION_SEND_SLOTS=64
# GENERATION_SLOW_READ_TIMEOUT_SECONDS=30
# GENERATION_SEND_TIMEOUT_SECONDS=30
# GENERATION_SHUTDOWN_GRACE_SECONDS=25
# 只读对账查询的响应上限（字节）：独立于生成响应上限，超限只留证据缺口。
# GENERATION_RECONCILIATION_READ_BYTES=1048576
# 预算观测记录的周期（秒）；0 表示不做周期记录，逐次容量拒绝仍然记录。
# GENERATION_OBSERVABILITY_INTERVAL_SECONDS=30
# 连接驱动与断开监视（Linux）：容量、控制队列与 HTTP/1、HTTP/2 缓冲上限，全部有缺省。
# API_MAX_CONNECTIONS=1024
# API_MAX_CONNECTION_TASKS=64
# API_MONITOR_CONTROL_QUEUE=1024
# API_MONITOR_CONFIRM_MILLIS=2000
# API_MAX_HEADERS=128
# API_MAX_BUFFER_BYTES=65536
# API_H2_MAX_CONCURRENT_STREAMS=128
# API_H2_MAX_SEND_BUFFER_BYTES=1048576
# API_H2_MAX_HEADER_LIST_BYTES=65536

# ── 异常对账（Worker）──────────────────────────────────────────────────
# Worker 每轮除旧路径领取外还跑异常对账；下面是它的批次、退避与慢周期核对取值，
# 全部有缺省。语义见 docs/operations/configuration.md §3「异常对账查询调度」。
# RECONCILIATION_BATCH_LIMIT=16
# RECONCILIATION_ORPHAN_MAX_AGE_SECONDS=900
# RECONCILIATION_LATE_FACT_CLAIM_TTL_SECONDS=300
# RECONCILIATION_QUERY_TIMEOUT_SECONDS=30
# RECONCILIATION_QUERY_MAX_ATTEMPTS=5
# RECONCILIATION_QUERY_BACKOFF_BASE_SECONDS=30
# RECONCILIATION_QUERY_BACKOFF_MAX_SECONDS=3600
# RECONCILIATION_LEDGER_AUDIT_EVERY_ROUNDS=10
# RECONCILIATION_LEDGER_AUDIT_LIMIT=100
# RECONCILIATION_LEDGER_AUDIT_WINDOW_SECONDS=3600
