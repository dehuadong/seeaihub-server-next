DATABASE_URL=postgres://seeai:seeai@127.0.0.1:54329/seeai_next
API_BIND=127.0.0.1:8081
ADMIN_TOKEN=replace-me
AIHUBMIX_API_KEY=
APIMART_API_KEY=
GENERATION_MAX_COST_MICROUSD=20000
GENERATION_MAX_CONCURRENT_JOBS=1
GENERATION_SYNC_WAIT_SECONDS=120
# 加速层（路由候选集与余额缓存）。REDIS_URL 留空即不启用：受理与结算全部回源数据库。
REDIS_URL=
CACHE_ROUTE_TTL_SECONDS=60
CACHE_BALANCE_TTL_SECONDS=360
CACHE_FRESHNESS_WINDOW_MS=5000
CACHE_RECONCILE_INTERVAL_MS=180000
CACHE_OPERATION_TIMEOUT_MS=200
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=900
PROVIDER_TIMEOUT_SECONDS=660
