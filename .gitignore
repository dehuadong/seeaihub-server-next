/target/
/.env
/.data/
/.idea/
/.vscode/
*.log
.scratch/
# Node 依赖目录：本地安装生成，不入版本库（覆盖 apps/web/node_modules）。
node_modules/
# 前端的构建产物：可重复生成，不入版本库（部署时再构建）。
apps/web/dist/
# Playwright 的运行产物：失败截图、trace 与 HTML 报告，本地生成。
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/
# 打包脚本的产物与编译缓存：本机生成，不入版本库。
/build/dist/
/build/.cache/
# 第三方可运行示例代码：随外部参考资源保留在本地，不入版本库。
# 其余 out-reference/ 内容（调研笔记、Schema 快照、错误码、计量证据样本）正常入库。
/out-reference/doubao/touch_edit_demo/
