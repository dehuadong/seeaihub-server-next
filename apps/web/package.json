{
  "name": "@seeai/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node e2e/check-bundle-isolation.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "e2e": "playwright test",
    "capture": "playwright test --config playwright.capture.config.ts",
    "check:isolation": "node e2e/check-bundle-isolation.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.0",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
