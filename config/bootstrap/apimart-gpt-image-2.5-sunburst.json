{
  "_comment": "APIMart 供给 gpt-image-2.5-sunburst 的运行时发布素材（新形状）。来源见 docs/facts/channel-facts.md §3。",
  "_status": "草案 · 未发布。文生图规格来自同一渠道族；图生图/遮罩按同渠道族 flare 的受控实测（docs/facts/channel-facts.md §5.6）开放。",
  "_evidence": "同 gpt-image-2.5-flare 的受控实测（out-reference/apimart/controlled-probe-2026-09-19.json 与 docs/facts/channel-facts.md §5.3/§5.6）：任务成功响应含四分项 usage，input_tokens_details 区分 text/image。机器 Schema 明确 Idempotency-Key，并声明 `image_urls`（string[]）与 `mask_url`；实测确认 `image_urls` 接受**字符串数组**、`mask_url` 可与之同用。上传接口合同见 §3.7，原始材料 out-reference/apimart/uploads-images.cn.md。",
  "_channel_differences": "本渠道与 AIHubMix 的差异全部落在 ② Adapter Driver：上游是任务式（提交→轮询→取图），参数在顶层（无 extra 包装），base_url 为 api.apib.ai。",
  "vendor_id": "OpenAI",
  "native_model_id": "gpt-image-2.5-sunburst",
  "native_revision": "2026-09-19-validated-1.0",
  "actor": "bootstrap",
  "offerings": [
    {
      "provider_kind": "APIMart",
      "adapter_key": "apimart-image-v1",
      "provider_model_id": "gpt-image-2.5-sunburst",
      "base_url": "https://api.apib.ai",
      "credential_env": "APIMART_API_KEY",
      "restrictions": {
        "allowed_branches": ["prompt_only", "image_conditioned", "masked"],
        "max_images": 16
      },
      "capability_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "prompt"],
        "properties": {
          "model": { "const": "gpt-image-2.5-sunburst" },
          "prompt": { "type": "string", "minLength": 1 },
          "n": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
          "size": {
            "anyOf": [
              { "const": "auto" },
              {
                "enum": [
                  "1:1", "3:2", "2:3", "4:3", "3:4", "5:4", "4:5",
                  "16:9", "9:16", "2:1", "1:2", "3:1", "1:3", "21:9", "9:21"
                ]
              },
              { "pattern": "^[0-9]+x[0-9]+$", "type": "string" }
            ]
          },
          "resolution": { "enum": ["1k", "2k", "4k"], "default": "1k" },
          "quality": {
            "enum": ["low", "medium", "high", "xhigh", "max", "auto"],
            "default": "auto"
          },
          "output_format": { "enum": ["png", "jpeg", "webp"], "default": "png" },
          "output_compression": { "type": "integer", "minimum": 0, "maximum": 100 },
          "background": { "enum": ["transparent", "opaque", "auto"] },
          "moderation": { "enum": ["auto", "low"], "default": "low" },
          "image_urls": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 16
          },
          "mask_url": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "required": ["mask_url"] },
            "then": { "required": ["image_urls"] }
          },
          {
            "if": {
              "properties": { "background": { "const": "transparent" } },
              "required": ["background"]
            },
            "then": { "properties": { "output_format": { "enum": ["png", "webp"] } } }
          },
          {
            "if": {
              "properties": { "output_compression": { "type": "integer" } },
              "required": ["output_compression"]
            },
            "then": {
              "required": ["output_format"],
              "properties": { "output_format": { "enum": ["jpeg", "webp"] } }
            }
          }
        ]
      },
      "price_plan": {
        "formula": "token_rates",
        "currency": "USD",
        "text_input_microusd_per_million": 5000000,
        "image_input_microusd_per_million": 8000000,
        "text_output_microusd_per_million": 10000000,
        "image_output_microusd_per_million": 30000000,
        "source_url": "https://docs.apib.ai/cn/api-reference/images/gpt-image-2.5/generation.md"
      }
    }
  ]
}
